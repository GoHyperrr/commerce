extend type Query {
  getCart(id: ID!): Cart
  getActiveCart(customerId: ID!): Cart
}

extend type Mutation {
  addItemToCart(cartId: ID!, input: AddItemInput!): Cart!
  removeItemFromCart(cartId: ID!, itemId: ID!): Cart!
  checkoutCart(cartId: ID!, input: CheckoutInput): Boolean!
}

type Cart {
  id: ID!
  customerId: String!
  status: String!
  items: [CartItem!]!
  shippingAddressId: String
  billingAddressId: String
  shippingAddressJson: String
  billingAddressJson: String
  paymentMethod: String
  shippingCarrier: String
  shippingMethod: String
}

type CartItem {
  id: ID!
  productId: String!
  quantity: Int!
  price: Float!
}

input AddItemInput {
  productId: String!
  quantity: Int!
  price: Float!
}
